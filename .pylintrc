[MESSAGES CONTROL]
disable=
    R0801,
    invalid-name,
    missing-function-docstring,
    missing-module-docstring,
    too-many-locals,
    too-many-statements,
    too-many-positional-arguments,
    too-many-arguments

[MASTER]
ignore=fd2bec/system.py,fd2bec/linear_system.py,fd2bec/cli/prepare_linear_system.py